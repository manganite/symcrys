{
  // Type check of everything that is not shipped as library code: tests, fixtures, test helpers,
  // scripts and config, with Node types (tests read the reference tables from disk). Also the editor
  // configuration. The library code itself is checked without any environment types by
  // tsconfig.build.json (npm run typecheck runs both). Because this file also covers src/ with Node
  // types, the editor does not flag Node APIs in library code; the gates (typecheck, lint) do.
  // audit/ is left out: it imports sibling checkouts (../birss-app, ../stereography), which CI lacks.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "vitest.config.ts", "eslint.config.js"]
}
