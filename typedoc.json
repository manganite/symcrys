{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/ts/src/index.ts", "packages/ts/src/magnetic.ts", "packages/ts/src/plane.ts"],
  "tsconfig": "packages/ts/tsconfig.build.json",
  "plugin": ["typedoc-plugin-missing-exports"],
  "out": "build/docs/ts-extra/ts",
  "json": "build/typedoc.json",
  "name": "symcrys",
  "readme": "none",
  "excludePrivate": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "sort": ["source-order"]
}
