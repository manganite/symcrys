{
  "name": "symcrys",
  "version": "0.7.0",
  "description": "Crystallographic symmetry calculations: point groups (crystallographic and magnetic), their settings, symbols and properties, and property tensors. TypeScript library without dependencies.",
  "keywords": [
    "crystallography",
    "symmetry",
    "point-groups",
    "magnetic-point-groups",
    "tensors"
  ],
  "author": "Thomas Lottermoser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manganite/symcrys.git",
    "directory": "packages/ts"
  },
  "bugs": "https://github.com/manganite/symcrys/issues",
  "homepage": "https://manganite.github.io/symcrys/",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./magnetic": {
      "types": "./dist/magnetic.d.ts",
      "default": "./dist/magnetic.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fixtures.ts",
    "!src/**/*.pins.json",
    "!src/**/testUtils/**"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
