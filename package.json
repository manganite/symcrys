{
  "name": "symcrys-repository",
  "private": true,
  "description": "Repository of symcrys: the TypeScript package (packages/ts, npm) and the Python package (packages/python, PyPI).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/ts"
  ],
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/typescript/bin/tsc -p packages/ts/tsconfig.build.json --noEmit",
    "typecheck:ts7": "node node_modules/typescript7/bin/tsc -p tsconfig.json && node node_modules/typescript7/bin/tsc -p packages/ts/tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w symcrys",
    "check:dist": "node scripts/check-dist.mjs",
    "bundle:python": "node scripts/bundle-python.mjs",
    "docs:ts": "typedoc",
    "docs:python": "typedoc && node scripts/python-api.mjs",
    "docs:check": "typedoc && node scripts/python-api.mjs --check && node node_modules/typescript/bin/tsc -p docs/tsconfig.json",
    "docs:site": "sphinx-build -W --keep-going -n -b html docs build/docs/html",
    "docs:linkcheck": "sphinx-build -W --keep-going -b linkcheck docs build/docs/linkcheck",
    "audit:wyckoff-2006": "vitest run --config audit/wyckoff-2006/vitest.config.ts",
    "audit:forms-2006": "vitest run --config audit/forms-2006/vitest.config.ts",
    "audit:plane-groups-2006": "vitest run --config audit/plane-groups-2006/vitest.config.ts",
    "audit:itc-baseline": "vitest run --config audit/itc-baseline/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.1.0"
  }
}
